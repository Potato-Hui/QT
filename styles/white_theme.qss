/* Qt 5 / RK3588 industrial white touchscreen theme. */

* {
    font-family: "Noto Sans CJK SC", "WenQuanYi Micro Hei", "Microsoft YaHei UI", "Microsoft YaHei", "DejaVu Sans";
    font-size: 18px;
    color: #10213D;
}

QMainWindow,
QWidget#centralWidget,
QWidget#monitorPage,
QWidget#recordsPage,
QWidget#photoDetailPage,
QStackedWidget#pageStack {
    background: #F5F7FA;
}

QFrame#headerFrame {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #DCE3EC;
}

QLabel#appTitleLabel {
    color: #0D2142;
    font-size: 30px;
    font-weight: 700;
}

QLabel#appSubTitleLabel {
    color: #687891;
    font-size: 16px;
}

QLabel#timeLabel {
    color: #0D2142;
    font-size: 29px;
    font-weight: 700;
}

QLabel#dateLabel {
    color: #63728A;
    font-size: 16px;
}

QFrame[card="true"] {
    background: #FFFFFF;
    border: 1px solid #D9E1EB;
    border-radius: 12px;
}

QLabel[role="pageTitle"] {
    color: #10213D;
    font-size: 29px;
    font-weight: 700;
}

QLabel[role="sectionTitle"] {
    color: #132543;
    font-size: 22px;
    font-weight: 700;
}

QLabel[role="muted"] {
    color: #718097;
    font-size: 16px;
}

QLabel[role="metricName"] {
    color: #52627A;
    font-size: 18px;
}

QLabel[role="metricValue"] {
    color: #10213D;
    font-size: 20px;
    font-weight: 700;
}

QFrame#previewCard {
    background: #FFFFFF;
    border: 1px solid #D9E1EB;
    border-radius: 12px;
}

QWidget#previewContainer {
    background: #101A2A;
    border: 1px solid #25334A;
    border-radius: 9px;
}

QLabel#previewLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel#previewHintLabel {
    color: #D4DCE8;
    font-size: 20px;
    font-weight: 600;
}

QLabel#previewSubHintLabel {
    color: #8997AC;
    font-size: 15px;
}

QLabel#runStatusDot {
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    border-radius: 6px;
}

QLabel#runStatusDot[state="idle"] {
    background: #9AA7B9;
}

QLabel#runStatusDot[state="running"] {
    background: #10A56A;
}

QLabel#runStatusDot[state="error"] {
    background: #E33D3D;
}

QLabel#resultValueLabel {
    color: #66758C;
    font-size: 30px;
    font-weight: 700;
    padding: 10px 0;
}

QLabel#resultValueLabel[resultState="normal"] {
    color: #06945E;
}

QLabel#resultValueLabel[resultState="alarm"] {
    color: #E22626;
}

QPushButton {
    min-height: 58px;
    padding: 0 22px;
    background: #FFFFFF;
    border: 1px solid #C9D3E1;
    border-radius: 9px;
    color: #173053;
    font-size: 19px;
    font-weight: 600;
}

QPushButton:hover {
    background: #F2F6FC;
    border-color: #7C91AE;
}

QPushButton:pressed {
    background: #E7EDF6;
}

QPushButton:disabled {
    background: #EEF1F5;
    border-color: #DEE4EC;
    color: #9AA6B7;
}

QPushButton#detectButton {
    min-height: 74px;
    background: #079660;
    border-color: #079660;
    color: #FFFFFF;
    font-size: 25px;
    font-weight: 700;
}

QPushButton#detectButton:hover {
    background: #078455;
    border-color: #078455;
}

QPushButton#detectButton[running="true"] {
    background: #D93939;
    border-color: #D93939;
}

QPushButton#snapshotButton,
QPushButton[primaryBlue="true"] {
    min-height: 74px;
    background: #1267E9;
    border-color: #1267E9;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 700;
}

QPushButton#snapshotButton:hover,
QPushButton[primaryBlue="true"]:hover {
    background: #0E58CB;
    border-color: #0E58CB;
}

QPushButton#recordsButton,
QPushButton#settingsButton {
    min-height: 62px;
    font-size: 19px;
}

QPushButton[compact="true"] {
    min-height: 48px;
    padding: 0 18px;
    font-size: 17px;
}

QPushButton[dangerOutline="true"] {
    background: #FFFFFF;
    border: 1px solid #F04444;
    color: #E32626;
}

QPushButton[dangerOutline="true"]:hover {
    background: #FFF2F2;
    border-color: #DC2222;
}

QPushButton[zoomControl="true"] {
    min-width: 50px;
    max-width: 50px;
    min-height: 48px;
    padding: 0;
    font-size: 24px;
}

QLabel#zoomValueLabel {
    min-width: 72px;
    color: #173053;
    font-size: 18px;
    font-weight: 700;
}

QTableWidget#recordsTable {
    background: #FFFFFF;
    alternate-background-color: #FAFBFD;
    border: 1px solid #D9E1EB;
    border-radius: 11px;
    gridline-color: #E1E7EF;
    selection-background-color: #E9F1FF;
    selection-color: #10213D;
    font-size: 18px;
    outline: none;
}

QTableWidget#recordsTable::item {
    padding: 10px 14px;
    border-bottom: 1px solid #E5EAF1;
}

QTableWidget#recordsTable::item:selected {
    background: #E9F1FF;
    color: #10213D;
}

QTableWidget#recordsTable QHeaderView::section {
    min-height: 52px;
    padding: 0 14px;
    background: #F7F9FC;
    color: #253754;
    border: none;
    border-bottom: 1px solid #DDE4ED;
    font-size: 18px;
    font-weight: 700;
}

QTableWidget#recordsTable QTableCornerButton::section {
    background: #F7F9FC;
    border: none;
    border-bottom: 1px solid #DDE4ED;
}

QLabel#recordsCountLabel {
    color: #34465F;
    font-size: 18px;
    font-weight: 600;
}

QFrame#detailImageCard {
    background: #132033;
    border: 1px solid #D9E1EB;
    border-radius: 12px;
}

QLabel#detailImageLabel {
    background: #132033;
    color: #AAB6C8;
    font-size: 18px;
}

QFrame#detailResultCard,
QFrame#detailInfoCard {
    background: #FFFFFF;
    border: 1px solid #D9E1EB;
    border-radius: 12px;
}

QLabel#detailResultValueLabel {
    min-height: 64px;
    font-size: 23px;
    font-weight: 700;
}

QFrame#footerFrame {
    background: #FFFFFF;
    border: none;
    border-top: 1px solid #DCE3EC;
}

QFrame#footerFrame QLabel {
    color: #334761;
    font-size: 17px;
}

QLabel#storageValueLabel,
QLabel#snapshotCountValueLabel {
    color: #087F56;
    font-size: 18px;
    font-weight: 700;
}

QScrollBar:vertical {
    width: 12px;
    background: #EEF2F6;
    margin: 0;
}

QScrollBar::handle:vertical {
    min-height: 36px;
    background: #B8C4D2;
    border-radius: 6px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
